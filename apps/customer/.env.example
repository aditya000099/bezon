# ── Bezon Customer App ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# API base URL (Vite proxy rewrites /api → this host in dev)
VITE_API_URL=http://localhost:5000

# App name shown in the UI
VITE_APP_NAME=Bezon

# Stripe publishable key (payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Google Maps API key (address autocomplete)
VITE_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxx

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
