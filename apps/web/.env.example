# ── Bezon Web — Environment Variables ────────────────────────────────────────
# Copy this file to .env.production or .env.local and fill in your values.
# NEVER commit .env files to git.

# API base URL — the root of your server (domain or IP)
# The frontend calls /api/... routes which Nginx proxies to Node.js.
# If using Nginx (recommended), this should be your domain root:
VITE_API_URL=http://YOUR_EC2_IP_OR_DOMAIN
