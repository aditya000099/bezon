{
  "name": "bezon",
  "version": "1.0.0",
  "private": true,
  "description": "Bezon ecommerce monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=apps/customer",
    "dev:seller": "npm run dev --workspace=apps/seller",
    "dev:delivery": "npm run dev --workspace=apps/delivery",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:all": "npm run dev --workspaces --if-present",
    "build:customer": "npm run build --workspace=apps/customer",
    "build:seller": "npm run build --workspace=apps/seller",
    "build:delivery": "npm run build --workspace=apps/delivery",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
